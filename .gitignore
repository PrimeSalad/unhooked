# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# native module build output
modules/*/android/build/

# sherpa-onnx AAR fetched at build time (fetchSherpaOnnx task)
modules/ginto-local-ai/android/libs/

# Release APKs go to GitHub Releases (over the 100 MB file limit)
/releases/*.apk
